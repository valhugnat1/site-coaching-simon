# En-têtes HTTP appliqués par Cloudflare Pages
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# Images : cache 7 jours (renomme le fichier si tu remplaces une image et que l'ancienne reste affichée)
/img/*
  Cache-Control: public, max-age=604800
